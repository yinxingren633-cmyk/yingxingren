---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<BaseLayout
  title={`${tag} 相关技术教程与配置指南 - 隐形人博客`}
  description={`关于“${tag}”的深度精选技术教程、选型对比与实操指南汇总。`}
  keywords={`${tag}, 科学上网, 翻墙出海, 稳定节点, 全球加速`}
>
  <div class="max-w-6xl mx-auto px-4 py-16">
    <!-- 面包屑 -->
    <div class="text-xs text-zinc-400 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-cyan-400">首页</a>
      <span>/</span>
      <span class="text-zinc-200">标签专题</span>
      <span>/</span>
      <span class="text-cyan-400 font-semibold">#{tag}</span>
    </div>

    <header class="mb-12 border-b border-white/5 pb-8 space-y-3">
      <div class="inline-block px-3 py-1 rounded-full bg-cyan-400/10 text-cyan-400 text-xs font-bold uppercase">
        TAG ARCHIVE
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white">
        标签专题：<span class="text-cyan-400">#{tag}</span>
      </h1>
      <p class="text-sm text-zinc-400">
        共检索到 {posts.length} 篇与该长尾技术关键词相关的深度评测与实操教程。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- 底部返回所有专题 -->
    <div class="mt-16 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-zinc-900 border border-white/10 hover:border-cyan-400/40 text-xs font-semibold text-zinc-300 hover:text-white transition-all"
      >
        ← 返回博客首页查看全部专题
      </a>
    </div>
  </div>
</BaseLayout>
