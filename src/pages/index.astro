---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import LiquidGlassHero from '../components/LiquidGlassHero.tsx';

// 获取所有文章，按发布时间倒序排列
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 提取置顶/核心推荐文章
const featuredPosts = sortedPosts.filter((p) => p.data.featured);

// 提取全站所有独立 Tags
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
---

<BaseLayout
  title="隐形人 (Invisibles) — 极速·隐秘·自由 | 科技技术博客"
  description="隐形人 (yinxingren.homes) 专注于为您提供 2026 最新 Clash 配置教程、美区 Apple ID 注册教学、IEPL 专线梯子方案横向评测与安全出海实操指南。"
  keywords="Clash 配置教程, 美区 Apple ID 注册, 网络加速节点优化, 梯子方案对比, 机场推荐替代选型, 便宜机场, 安全机场, 科学上网, 翻墙出海, 全球加速"
  hideHeader={true}
>
  <!-- 视频液态玻璃 Liquid Glass Hero 区域 -->
  <LiquidGlassHero client:load tags={allTags} />

  <!-- 隐藏备用全局搜索输入挂载点 (供 Hero 实时驱动) -->
  <div class="hidden">
    <input type="text" id="search-input" />
  </div>

  <!-- 核心置顶指南 (Sticky Featured Guides) -->
  {featuredPosts.length > 0 && (
    <section class="py-12 border-b border-white/5 bg-zinc-950/40" id="featured">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">RECOMMENDED</span>
            <h2 class="text-2xl font-bold text-white mt-1">必读新手入门与核心指南</h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 全部技术文章列表 (All Tutorials) -->
  <section class="py-16" id="tutorials">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">ALL ARTICLES</span>
          <h2 class="text-2xl font-bold text-white mt-1">最新技术教程与网络测评</h2>
        </div>
        <span class="text-xs text-zinc-500">共收录 {allPosts.length} 篇精选指南</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
