---
const navLinks = [
  { name: '首页', href: '/' },
  { name: 'Clash 专栏', href: '/tags/Clash%20配置教程' },
  { name: '美区 Apple ID', href: '/tags/美区%20Apple%20ID%20注册' },
  { name: '节点优化', href: '/tags/网络加速节点优化' },
  { name: '常见问题 (FAQ)', href: '/faq' },
];
---

<!-- 顶部状态小标签 (极简浅色) -->
<div class="bg-gray-50/80 border-b border-black/5 py-1 text-[11px] text-[#767676]">
  <div class="max-w-6xl mx-auto px-6 flex flex-wrap justify-between items-center gap-2">
    <div class="flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-medium text-[#1a1a1a]">2026 最新网络节点实测与官方配置规范</span>
    </div>
    <div class="flex items-center gap-4 text-[#767676]">
      <span>🛡️ 经网络架构师安全审计</span>
      <span>🔄 最近更新：2026年9月</span>
    </div>
  </div>
</div>

<!-- 主导航栏 (极简白毛玻璃 Liquid Glass) -->
<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-black/5 transition-all">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- 品牌 Logo + invisible 标题 (含 SVG 回退) -->
    <a href="/" class="flex items-center gap-3 no-underline group">
      <!-- Attempt to render logo.png; fallback gracefully to inline SVG if missing -->
      <img 
        src="/logo.png" 
        alt="Logo" 
        class="w-8 h-8 object-contain flex-shrink-0"
        onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='block';"
      />
      <svg class="w-8 h-8 text-black hidden flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <span class="font-display text-[36px] max-md:text-[28px] text-black leading-none select-none">invisible</span>
    </a>

    <!-- 桌面端菜单导航 -->
    <nav class="hidden md:flex items-center gap-7 text-[15px] font-medium">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="text-[#1a1a1a] hover:opacity-55 transition-opacity"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- 右侧行动区 (GitHub 图标 + 行动按钮) -->
    <div class="flex items-center gap-4">
      <!-- GitHub 仓库图标链接 (w-6 h-6) -->
      <a
        href="https://github.com/yinxingren633-cmyk/yingxingren"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        class="p-1 text-black hover:opacity-60 transition-opacity flex items-center justify-center"
        title="View on GitHub"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>

      <!-- 登录 / 注册专线 CTA 按钮 -->
      <a
        href="https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#0a0a0a] text-white rounded-full px-5 py-2 text-sm font-medium hover:bg-[#333] active:scale-95 transition-all shadow-sm"
      >
        <span>登录 / 注册节点</span>
      </a>
    </div>
  </div>
</header>
