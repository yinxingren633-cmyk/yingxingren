---
const navLinks = [
  { name: '首页', href: '/' },
  { name: 'Clash 专栏', href: '/tags/Clash%20配置教程' },
  { name: '美区 Apple ID', href: '/tags/美区%20Apple%20ID%20注册' },
  { name: '方案深度评测', href: '/tags/梯子方案对比' },
  { name: '节点优化', href: '/tags/网络加速节点优化' },
  { name: '常见问答 (FAQ)', href: '/faq' },
];
---

<!-- 顶部 E-E-A-T 状态条 -->
<div class="bg-black/60 border-b border-white/5 py-1.5 text-xs text-zinc-400 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 flex flex-wrap justify-between items-center gap-2">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-medium text-zinc-300">2026年最新网络节点实测与配置规范</span>
    </div>
    <div class="flex items-center gap-4 text-zinc-400">
      <span>🛡️ 经网络架构师安全审计</span>
      <span>🔄 最近更新：2026年9月</span>
    </div>
  </div>
</div>

<!-- 主导航栏 (毛玻璃苹果设计风格) -->
<header class="sticky top-0 z-50 bg-black/80 backdrop-blur-xl border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- 品牌区 (应用指定的萌系卡通 Logo) -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/logo.png"
        alt="隐形人博客 Logo"
        class="w-10 h-10 rounded-xl object-contain bg-white shadow-md border border-white/20 transition-transform group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="font-bold text-lg text-white tracking-tight leading-tight">隐形人</span>
        <span class="text-[10px] text-cyan-400 font-semibold tracking-wider uppercase">Invisible Tech Blog</span>
      </div>
    </a>

    <!-- 桌面端菜单导航 -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="text-zinc-400 hover:text-white transition-colors duration-200"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- 右侧行动 CTA -->
    <div class="flex items-center gap-3">
      <a
        href="https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-black bg-gradient-to-r from-cyan-400 to-blue-500 shadow-md shadow-cyan-500/20 hover:shadow-cyan-500/40 hover:scale-105 transition-all duration-200"
      >
        <span>⚡ 专线入口</span>
      </a>
    </div>
  </div>
</header>
