---
const navLinks = [
  { name: '首页', href: '/' },
  { name: 'Clash 专栏', href: '/tags/Clash%20配置教程' },
  { name: '美区 Apple ID', href: '/tags/美区%20Apple%20ID%20注册' },
  { name: '方案深度评测', href: '/tags/梯子方案对比' },
  { name: '节点优化', href: '/tags/网络加速节点优化' },
  { name: '常见问答 (FAQ)', href: '/faq' },
];
---

<!-- 顶部 E-E-A-T 状态条 -->
<div class="bg-black/60 border-b border-white/5 py-1.5 text-xs text-zinc-400 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 flex flex-wrap justify-between items-center gap-2">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-medium text-zinc-300">2026年最新网络节点实测与配置规范</span>
    </div>
    <div class="flex items-center gap-4 text-zinc-400">
      <span>🛡️ 经网络架构师安全审计</span>
      <span>🔄 最近更新：2026年9月</span>
    </div>
  </div>
</div>

<!-- 主导航栏 (毛玻璃苹果设计风格) -->
<header class="sticky top-0 z-50 bg-black/80 backdrop-blur-xl border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- 品牌区 (应用指定的萌系卡通 Logo) -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/logo.png"
        alt="隐形人博客 Logo"
        width="40"
        height="40"
        loading="eager"
        class="w-10 h-10 rounded-xl object-contain bg-white shadow-md border border-white/20 transition-transform group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="font-bold text-lg text-white tracking-tight leading-tight">隐形人</span>
        <span class="text-[10px] text-cyan-400 font-semibold tracking-wider uppercase">Invisible Tech Blog</span>
      </div>
    </a>

    <!-- 桌面端菜单导航 -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="text-zinc-400 hover:text-white transition-colors duration-200"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- 右侧行动区 (导航/GitHub/高转化CTA) -->
    <div class="flex items-center gap-3 md:gap-4">
      <!-- GitHub 仓库图标链接 -->
      <a
        href="https://github.com/yinxingren633-cmyk/yingxingren"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        class="p-1.5 text-zinc-400 hover:text-white hover:bg-white/10 rounded-full transition-all flex items-center justify-center"
        title="View on GitHub"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>

      <!-- 高显眼度主要转化 CTA -->
      <a
        href="https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 md:px-5 py-2 rounded-full text-xs font-bold text-black bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 shadow-md shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>⚡ 登录 / 注册节点</span>
      </a>
    </div>
  </div>
</header>
