---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, badge, author } = post.data;
const dateStr = pubDate.toISOString().split('T')[0];
---

<article
  class="blog-card-item group relative rounded-3xl bg-zinc-900/60 border border-white/10 p-6 md:p-8 backdrop-blur-xl hover:border-cyan-400/40 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-500/10 transition-all duration-300 flex flex-col justify-between"
  data-title={title}
  data-desc={description}
  data-tags={tags.join(' ')}
>
  <div>
    <!-- 头部标签与发布日期 -->
    <div class="flex items-center justify-between gap-2 mb-4 text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        {badge && (
          <span class="px-2.5 py-0.5 rounded-full bg-cyan-400/10 border border-cyan-400/30 text-cyan-400 font-semibold">
            {badge}
          </span>
        )}
        <span class="text-zinc-500">📅 {dateStr}</span>
      </div>
      <span class="text-zinc-500 text-[11px]">{author}</span>
    </div>

    <!-- 标题 -->
    <h2 class="text-xl md:text-2xl font-bold text-white group-hover:text-cyan-400 transition-colors mb-3 leading-snug">
      <a href={`/blog/${post.slug}`} class="stretched-link">
        {title}
      </a>
    </h2>

    <!-- 描述 -->
    <p class="text-sm text-zinc-400 line-clamp-3 mb-6 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- 底部标签与阅读全文行动 -->
  <div class="pt-4 border-t border-white/5 flex items-center justify-between flex-wrap gap-3">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class="relative z-10 px-2 py-0.5 rounded-md bg-white/5 hover:bg-cyan-400/10 text-zinc-400 hover:text-cyan-400 text-xs transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>
    <span class="text-xs font-semibold text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
      阅读全文 →
    </span>
  </div>
</article>
