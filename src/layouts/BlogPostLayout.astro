---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import CallToAction from '../components/CallToAction.astro';

export interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, headings, relatedPosts } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, keywords, heroImage } = post.data;

const formattedDate = pubDate.toISOString().split('T')[0];
const formattedUpdate = updatedDate ? updatedDate.toISOString().split('T')[0] : null;
const formattedKeywords = Array.isArray(keywords) ? keywords.join(', ') : (keywords || tags.join(', '));

// 预估阅读时间计算 (基于中文与英文词频)
const wordCount = post.body.length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 350));
---

<BaseLayout
  title={title}
  description={description}
  keywords={formattedKeywords}
  type="article"
  image={heroImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
>
  <!-- 顶部文章面包屑 -->
  <nav aria-label="Breadcrumb" class="border-b border-gray-100 bg-[#fafafa] py-3">
    <div class="max-w-4xl mx-auto px-6 text-xs text-[#767676] flex items-center gap-2">
      <a href="/" class="hover:text-[#905831] transition-colors">首页</a>
      <span>/</span>
      <a href="/#tutorials" class="hover:text-[#905831] transition-colors">博客教程</a>
      <span>/</span>
      <span class="text-[#1a1a1a] truncate max-w-xs">{title}</span>
    </div>
  </nav>

  <article class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    <!-- 文章头部 Header -->
    <header class="mb-10 text-center md:text-left space-y-4">
      <div class="flex flex-wrap items-center gap-2 justify-center md:justify-start text-xs">
        {tags.map((tag: string) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="px-3 py-1 rounded-full bg-gray-100 text-[#767676] hover:bg-[#905831]/10 hover:text-[#905831] font-medium transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>

      <h1 class="text-2xl md:text-4xl font-bold text-[#1a1a1a] tracking-tight leading-tight">
        {title}
      </h1>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs text-[#767676] pt-2 border-t border-gray-100">
        <span class="flex items-center gap-1.5">
          <span>✍️ 作者：</span>
          <span class="text-[#1a1a1a] font-medium">{author}</span>
        </span>
        <span>•</span>
        <span>📅 发布时间：<time datetime={formattedDate}>{formattedDate}</time></span>
        <span>•</span>
        <span>⏱️ 阅读时间：约 {readingTimeMinutes} 分钟 ({wordCount} 字)</span>
        {formattedUpdate && (
          <>
            <span>•</span>
            <span class="text-[#905831]">🔄 最近修订：<time datetime={formattedUpdate}>{formattedUpdate}</time></span>
          </>
        )}
      </div>
    </header>

    <!-- 移动端 TOC 大纲 -->
    <div class="mb-8 block md:hidden">
      <TOC headings={headings} />
    </div>

    <!-- 文章正文区域与桌面端目录 -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-3">
        <div class="prose prose-slate max-w-none prose-headings:scroll-mt-24 prose-headings:text-[#1a1a1a] prose-headings:font-bold prose-p:text-[#4a4a4a] prose-p:leading-relaxed prose-a:text-[#905831] hover:prose-a:underline prose-code:text-[#905831] prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none prose-pre:bg-[#1e1e1e] prose-pre:border prose-pre:border-gray-200 rounded-2xl">
          <slot />
        </div>

        <!-- 正文底部高转化行动邀请组件 (Reusable CallToAction) -->
        <CallToAction />
      </div>

      <!-- 桌面端侧边栏 TOC -->
      <aside class="hidden md:block md:col-span-1">
        <div class="sticky top-24 space-y-6">
          <TOC headings={headings} />

          <!-- 侧边栏长尾词推荐 -->
          <div class="p-5 rounded-2xl bg-white border border-gray-100 shadow-sm text-xs space-y-3">
            <div class="font-semibold text-[#1a1a1a]">热门分类检索</div>
            <div class="flex flex-col gap-2 text-[#767676]">
              <a href="/tags/Clash%20配置教程" class="hover:text-[#905831] transition-colors">⚡ Clash Verge 配置</a>
              <a href="/tags/美区%20Apple%20ID%20注册" class="hover:text-[#905831] transition-colors">🍏 美区 Apple ID 注册</a>
              <a href="/tags/梯子方案对比" class="hover:text-[#905831] transition-colors">📊 IEPL 专线对比</a>
              <a href="/tags/网络加速节点优化" class="hover:text-[#905831] transition-colors">🛡️ DNS 防泄漏设置</a>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- 相关文章推荐 (SEO 内部拓扑环流) -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-12 border-t border-gray-100">
        <h3 class="text-xl font-bold text-[#1a1a1a] mb-6 flex items-center gap-2">
          <span>📚</span>
          <span>相关技术教程推荐</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedPosts.map((rel) => (
            <a
              href={`/blog/${rel.slug}`}
              class="p-5 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md hover:border-[#905831]/30 transition-all block group"
            >
              <div class="text-xs text-[#905831] font-medium mb-1.5">
                {rel.data.tags[0] ? `#${rel.data.tags[0]}` : '技术教程'}
              </div>
              <h4 class="font-semibold text-[#1a1a1a] group-hover:text-[#905831] text-sm line-clamp-2 leading-snug transition-colors">
                {rel.data.title}
              </h4>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
